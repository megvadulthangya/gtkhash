<?xml version="1.0" encoding="UTF-8"?>
<interface domain="gtkhash">
  <requires lib="gtk" version="4.0"/>
  <object class="GtkListStore" id="dialog_liststore">
    <columns>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Lowercase Hexadecimal</col>
      </row>
      <row>
        <col id="0" translatable="yes">Uppercase Hexadecimal</col>
      </row>
      <row>
        <col id="0">Base64</col>
      </row>
    </data>
  </object>
  <object class="GtkImage" id="image_copy">
    <property name="visible">True</property>
    <property name="icon_name">edit-copy</property>
  </object>
  <object class="GtkMenu" id="menu_treeview">
    <property name="visible">True</property>
    <child>
      <object class="GtkMenuItem" id="menuitem_treeview_add">
        <property name="label">gtk-add</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon_name">list-add</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">gtk-add</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="menuitem_treeview_remove">
        <property name="label">gtk-remove</property>
        <property name="visible">True</property>
        <property name="sensitive">False</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon_name">list-remove</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">gtk-remove</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="menuitem_treeview_clear">
        <property name="label">gtk-clear</property>
        <property name="visible">True</property>
        <property name="sensitive">False</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon_name">edit-clear</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">gtk-clear</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" id="menuitem_treeview_separator1">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="menuitem_treeview_copy">
        <property name="label" translatable="yes">Copy _Digest</property>
        <property name="visible">True</property>
        <property name="sensitive">False</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon_name">edit-copy</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Copy _Digest</property>
              </object>
            </child>
          </object>
        </child>
        <child type="submenu">
          <object class="GtkMenu" id="menu_treeview_copy">
            <property name="visible">True</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" id="menuitem_treeview_separator2">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkCheckMenuItem" id="menuitem_treeview_show_toolbar">
        <property name="visible">True</property>
        <property name="label" translatable="yes">Show _Toolbar</property>
      </object>
    </child>
  </object>
  <object class="GtkImage" id="image_execute">
    <property name="visible">True</property>
    <property name="icon_name">system-run</property>
  </object>
  <object class="GtkImage" id="image_open">
    <property name="visible">True</property>
    <property name="icon_name">document-open</property>
  </object>
  <object class="GtkImage" id="image_save_as">
    <property name="visible">True</property>
    <property name="icon_name">document-save-as</property>
  </object>
  <object class="GtkWindow" id="window">
    <property name="title">GtkHash</property>
    <property name="default_width">500</property>
    <property name="default_height">340</property>
    <property name="icon_name">org.gtkhash.gtkhash</property>
    <child>
      <object class="GtkBox" id="vbox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkMenuBar" id="menubar">
            <child>
              <object class="GtkMenuItem" id="menuitem_file">
                <property name="label" translatable="yes">_File</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_file">
                    <child>
                      <object class="GtkMenuItem" id="menuitem_open">
                        <property name="label" translatable="yes" context="menu">_Open Digest File…</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">document-open</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes" context="menu">_Open Digest File…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_save_as">
                        <property name="label" translatable="yes" context="menu">_Save Digest File…</property>
                        <property name="sensitive">False</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">document-save-as</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes" context="menu">_Save Digest File…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem"/>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_quit">
                        <property name="label">gtk-quit</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">application-exit</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-quit</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menuitem_edit">
                <property name="label" translatable="yes">_Edit</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_edit">
                    <child>
                      <object class="GtkMenuItem" id="menuitem_cut">
                        <property name="label">gtk-cut</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">edit-cut</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-cut</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_copy">
                        <property name="label">gtk-copy</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">edit-copy</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-copy</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_paste">
                        <property name="label">gtk-paste</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">edit-paste</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-paste</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_delete">
                        <property name="label">gtk-delete</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">edit-delete</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-delete</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem"/>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_select_all">
                        <property name="label">gtk-select-all</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">edit-select-all</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-select-all</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem"/>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menuitem_prefs">
                        <property name="label">gtk-preferences</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">preferences-system</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-preferences</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menuitem_view">
                <property name="label" translatable="yes">_View</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_view">
                    <child>
                      <object class="GtkCheckMenuItem" id="radiomenuitem_file">
                        <property name="label" translatable="yes">_File</property>
                        <property name="active">True</property>
                        <property name="group">radiomenuitem_file</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="radiomenuitem_text">
                        <property name="label" translatable="yes">_Text</property>
                        <property name="group">radiomenuitem_file</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="radiomenuitem_file_list">
                        <property name="label" translatable="yes">File _List</property>
                        <property name="group">radiomenuitem_file</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menuitem_help">
                <property name="label" translatable="yes">_Help</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_help">
                    <child>
                      <object class="GtkMenuItem" id="menuitem_about">
                        <property name="label">gtk-about</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">help-about</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">gtk-about</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox_app">
            <property name="margin_start">6</property>
            <property name="margin_end">6</property>
            <property name="margin_top">6</property>
            <property name="margin_bottom">6</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkBox" id="vbox_single">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox" id="hbox_input">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkBox" id="vbox_inputlabels">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <property name="homogeneous">True</property>
                        <child>
                          <object class="GtkLabel" id="label_file">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">File:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_text">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Text:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_check">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Check:</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="vbox_inputdata">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <property name="homogeneous">True</property>
                        <child>
                          <object class="GtkFileChooserButton" id="filechooserbutton">
                            <property name="local_only">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="entry_text"/>
                        </child>
                        <child>
                          <object class="GtkBox" id="hbox_check">
                            <property name="spacing">2</property>
                            <child>
                              <object class="GtkEntry" id="entry_check_file">
                                <property name="truncate_multiline">True</property>
                                <property name="primary_icon_name">edit-paste</property>
                                <property name="primary_icon_tooltip_text" translatable="yes">Paste digest from clipboard</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_check_text">
                                <property name="truncate_multiline">True</property>
                                <property name="primary_icon_name">edit-paste</property>
                                <property name="primary_icon_tooltip_text" translatable="yes">Paste digest from clipboard</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="togglebutton_hmac_file">
                                <property name="label" translatable="yes">HMAC Key:</property>
                                <property name="draw_indicator">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_hmac_file">
                                <property name="visibility">False</property>
                                <property name="caps_lock_warning">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="togglebutton_hmac_text">
                                <property name="label" translatable="yes">HMAC Key:</property>
                                <property name="draw_indicator">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_hmac_text">
                                <property name="visibility">False</property>
                                <property name="caps_lock_warning">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="hseparator_single"/>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow_output">
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkViewport" id="viewport_output">
                        <property name="valign">start</property>
                        <child>
                          <object class="GtkBox" id="hbox_output">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkBox" id="vbox_outputlabels">
                                <property name="orientation">vertical</property>
                                <property name="spacing">3</property>
                                <property name="homogeneous">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="vbox_digests_file">
                                <property name="orientation">vertical</property>
                                <property name="spacing">3</property>
                                <property name="homogeneous">True</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="vbox_digests_text">
                                <property name="orientation">vertical</property>
                                <property name="spacing">3</property>
                                <property name="homogeneous">True</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox_list">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow_list">
                    <property name="min_content_width">450</property>
                    <property name="min_content_height">150</property>
                    <child>
                      <object class="GtkTreeView" id="treeview">
                        <property name="rules_hint">True</property>
                        <property name="search_column">2</property>
                        <property name="show_expanders">False</property>
                        <property name="rubber_banding">True</property>
                        <property name="tooltip_column">3</property>
                        <child internal-child="selection">
                          <object class="GtkTreeSelection" id="treeselection">
                            <property name="mode">multiple</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_status">
                            <property name="visible">False</property>
                            <property name="clickable">True</property>
                            <property name="sort_indicator">True</property>
                            <property name="sort_column_id">1</property>
                            <child>
                              <object class="GtkCellRendererPixbuf" id="cellrenderer_status"/>
                              <attributes>
                                <attribute name="icon-name">1</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_icon_name">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_icon_name"/>
                              <attributes>
                                <attribute name="text">1</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_file">
                            <property name="resizable">True</property>
                            <property name="min_width">100</property>
                            <property name="title" translatable="yes">File</property>
                            <property name="clickable">True</property>
                            <property name="sort_indicator">True</property>
                            <property name="sort_column_id">2</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_file"/>
                              <attributes>
                                <attribute name="text">2</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_basename">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_basename"/>
                              <attributes>
                                <attribute name="text">3</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_check">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_check"/>
                              <attributes>
                                <attribute name="text">4</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <style>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox_buttons">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkSeparator" id="hseparator_buttons"/>
                </child>
                <child>
                  <object class="GtkBox" id="hbox_buttons">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkProgressBar" id="progressbar">
                        <property name="show_text">True</property>
                        <property name="ellipsize">middle</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButtonBox" id="hbuttonbox">
                        <property name="spacing">6</property>
                        <property name="layout_style">end</property>
                        <child>
                          <object class="GtkButton" id="button_hash">
                            <property name="label" translatable="yes">Ha_sh</property>
                            <property name="sensitive">False</property>
                            <property name="can_default">True</property>
                            <property name="receives_default">True</property>
                            <property name="use_underline">True</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">system-run</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_stop">
                            <property name="label">gtk-stop</property>
                            <property name="can_default">True</property>
                            <property name="receives_default">True</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon_name">process-stop</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog">
    <property name="margin_start">6</property>
    <property name="margin_end">6</property>
    <property name="margin_top">6</property>
    <property name="margin_bottom">6</property>
    <property name="title" translatable="yes">GtkHash Preferences</property>
    <property name="destroy_with_parent">True</property>
    <property name="type_hint">dialog</property>
    <property name="transient_for">window</property>
    <child internal-child="action_area">
      <object class="GtkButtonBox">
        <property name="layout_style">end</property>
        <child>
          <object class="GtkButton" id="dialog_button_close">
            <property name="label">gtk-close</property>
            <property name="can_default">True</property>
            <property name="receives_default">True</property>
            <child>
              <object class="GtkImage">
                <property name="icon_name">window-close</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkFrame">
        <property name="label_xalign">0</property>
        <child>
          <object class="GtkGrid" id="dialog_grid">
            <property name="row_homogeneous">True</property>
            <property name="column_homogeneous">True</property>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel">
            <property name="label" translatable="yes">Hash Functions</property>
            <attributes>
