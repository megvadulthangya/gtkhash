<?xml version="1.0" encoding="UTF-8"?>
<interface domain="gtkhash">
  <requires lib="gtk" version="4.0"/>

  <object class="GtkListStore" id="dialog_liststore">
    <columns>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Lowercase Hexadecimal</col>
      </row>
      <row>
        <col id="0" translatable="yes">Uppercase Hexadecimal</col>
      </row>
      <row>
        <col id="0">Base64</col>
      </row>
    </data>
  </object>

  <object class="GtkApplicationWindow" id="window">
    <property name="title">GtkHash</property>
    <property name="default_width">500</property>
    <property name="default_height">340</property>
    <property name="icon_name">org.gtkhash.gtkhash</property>
    <child>
      <object class="GtkBox" id="vbox">
        <property name="orientation">vertical</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox" id="vbox_app">
            <property name="margin_start">6</property>
            <property name="margin_end">6</property>
            <property name="margin_top">6</property>
            <property name="margin_bottom">6</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox" id="vbox_single">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkBox" id="hbox_input">
                    <property name="spacing">6</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkBox" id="vbox_inputlabels">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <property name="homogeneous">True</property>
                        <child>
                          <object class="GtkLabel" id="label_file">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">File:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_text">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Text:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_check">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Check:</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="vbox_inputdata">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <property name="homogeneous">True</property>
                        <property name="hexpand">True</property>
                        <child>
                          <object class="GtkButton" id="filechooserbutton">
                            <property name="label" translatable="yes">Choose File…</property>
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="entry_text">
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="hbox_check">
                            <property name="spacing">2</property>
                            <property name="hexpand">True</property>
                            <child>
                              <object class="GtkEntry" id="entry_check_file">
                                <property name="primary_icon_name">edit-paste</property>
                                <property name="primary_icon_tooltip_text" translatable="yes">Paste digest from clipboard</property>
                                <property name="hexpand">True</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_check_text">
                                <property name="primary_icon_name">edit-paste</property>
                                <property name="primary_icon_tooltip_text" translatable="yes">Paste digest from clipboard</property>
                                <property name="hexpand">True</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="togglebutton_hmac_file">
                                <property name="label" translatable="yes">HMAC Key:</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_hmac_file">
                                <property name="visibility">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="togglebutton_hmac_text">
                                <property name="label" translatable="yes">HMAC Key:</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_hmac_text">
                                <property name="visibility">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="hseparator_single"/>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow_output">
                    <property name="hscrollbar_policy">never</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkBox" id="hbox_output">
                        <property name="spacing">6</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">False</property>
                        <property name="valign">start</property>
                        <child>
                          <object class="GtkBox" id="vbox_outputlabels">
                            <property name="orientation">vertical</property>
                            <property name="spacing">3</property>
                            <property name="vexpand">False</property>
                            <property name="valign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="vbox_digests_file">
                            <property name="orientation">vertical</property>
                            <property name="spacing">3</property>
                            <property name="hexpand">True</property>
                            <property name="vexpand">False</property>
                            <property name="valign">start</property>
                            <style>
                              <class name="monospace"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="vbox_digests_text">
                            <property name="orientation">vertical</property>
                            <property name="spacing">3</property>
                            <property name="hexpand">True</property>
                            <property name="vexpand">False</property>
                            <property name="valign">start</property>
                            <style>
                              <class name="monospace"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox_list">
                <property name="orientation">vertical</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkBox" id="toolbar">
                    <property name="spacing">6</property>
                    <property name="halign">start</property>
                    <child>
                      <object class="GtkButton" id="toolbutton_add">
                        <property name="label" translatable="yes">Add</property>
                        <property name="tooltip-text" translatable="yes">Add files to the list</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="toolbutton_remove">
                        <property name="label" translatable="yes">Remove</property>
                        <property name="tooltip-text" translatable="yes">Remove selected files from the list</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="toolbutton_clear">
                        <property name="label" translatable="yes">Clear</property>
                        <property name="tooltip-text" translatable="yes">Clear the list</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow_list">
                    <property name="min_content_width">450</property>
                    <property name="min_content_height">150</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkTreeView" id="treeview">
                        <property name="search_column">2</property>
                        <property name="show_expanders">False</property>
                        <property name="rubber_banding">True</property>
                        <property name="tooltip_column">3</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_status">
                            <property name="visible">False</property>
                            <property name="clickable">True</property>
                            <property name="sort_indicator">True</property>
                            <property name="sort_column_id">1</property>
                            <child>
                              <object class="GtkCellRendererPixbuf" id="cellrenderer_status"/>
                              <attributes>
                                <attribute name="icon-name">1</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_icon_name">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_icon_name"/>
                              <attributes>
                                <attribute name="text">1</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_file">
                            <property name="resizable">True</property>
                            <property name="expand">True</property>
                            <property name="min_width">100</property>
                            <property name="title" translatable="yes">File</property>
                            <property name="clickable">True</property>
                            <property name="sort_indicator">True</property>
                            <property name="sort_column_id">2</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_file">
                                <property name="ellipsize">end</property>
                              </object>
                              <attributes>
                                <attribute name="text">2</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_basename">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_basename"/>
                              <attributes>
                                <attribute name="text">3</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="treeviewcolumn_check">
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkCellRendererText" id="cellrenderer_check"/>
                              <attributes>
                                <attribute name="text">4</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <style>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox_buttons">
                <property name="orientation">vertical</property>
                <property name="vexpand">False</property>
                <child>
                  <object class="GtkSeparator" id="hseparator_buttons"/>
                </child>
                <child>
                  <object class="GtkBox" id="hbox_buttons">
                    <property name="spacing">6</property>
                    <property name="valign">center</property>
                    <property name="vexpand">False</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkProgressBar" id="progressbar">
                        <property name="show_text">True</property>
                        <property name="ellipsize">middle</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbuttonbox">
                        <property name="spacing">6</property>
                        <property name="halign">end</property>
                        <property name="hexpand">False</property>
                        <property name="vexpand">False</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkButton" id="button_hash">
                            <property name="sensitive">False</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon_name">system-run</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Hash</property>
                                    <property name="use_underline">True</property>
                                    <property name="mnemonic_widget">button_hash</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_stop">
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon_name">process-stop</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Stop</property>
                                    <property name="use_underline">True</property>
                                    <property name="mnemonic_widget">button_stop</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="GtkDialog" id="dialog">
    <property name="title" translatable="yes">GtkHash Preferences</property>
    <property name="transient_for">window</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="margin_start">6</property>
        <property name="margin_end">6</property>
        <property name="margin_top">6</property>
        <property name="margin_bottom">6</property>
        <child>
          <object class="GtkFrame">
            <property name="label_xalign">0</property>
            <child>
              <object class="GtkGrid" id="dialog_grid">
                <property name="row_homogeneous">True</property>
                <property name="column_homogeneous">True</property>
              </object>
            </child>
            <child type="label">
              <object class="GtkLabel">
                <property name="label" translatable="yes">Hash Functions</property>
                <attributes>
                  <attribute name="weight" value="bold"/>
                </attributes>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame">
            <property name="label_xalign">0</property>
            <child>
              <object class="GtkCheckButton" id="dialog_togglebutton_show_hmac">
                <property name="label">HMAC</property>
              </object>
            </child>
            <child type="label">
              <object class="GtkLabel">
                <property name="label" translatable="yes">MAC Functions</property>
                <attributes>
                  <attribute name="weight" value="bold"/>
                </attributes>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Digest Format:</property>
                <attributes>
                  <attribute name="weight" value="bold"/>
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkComboBox" id="dialog_combobox">
                <property name="model">dialog_liststore</property>
                <property name="active">0</property>
                <child>
                  <object class="GtkCellRendererText"/>
                  <attributes>
                    <attribute name="text">0</attribute>
                  </attributes>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="halign">end</property>
            <property name="margin_top">6</property>
            <child>
              <object class="GtkButton" id="dialog_button_close">
                <property name="label">gtk-close</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">window-close</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="GtkPopoverMenu" id="menu_treeview">
  </object>
</interface>